<!--
    geetRPCS - Help & Guide window (ModernWpf / Fluent).
    Built-in guide distilled from the README so users never have to open
    GitHub or the install folder to learn how the app works: getting
    started, presence customization, features, updates, troubleshooting
    and About (with links to the full online docs).
-->
<Window x:Class="geetRPCS.UI.Modern.GuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="Help &amp; Guide"
        Width="760" Height="560"
        MinWidth="620" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ui:ThemeManager.IsThemeAware="True"
        UseLayoutRounding="True"
        Background="{DynamicResource ApplicationPageBackgroundThemeBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left navigation -->
        <Border Grid.Column="0" Margin="16,16,8,16" Padding="0,8" CornerRadius="8"
                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
            <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0"
                     Padding="8" SelectionChanged="OnNavSelectionChanged" />
        </Border>

        <!-- Topic content -->
        <Grid Grid.Column="1" Margin="8,16,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ContentHost" Margin="8,4,8,8" />
            </ScrollViewer>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="CloseButton" Width="96" Height="32" IsCancel="True" Click="OnCloseClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
