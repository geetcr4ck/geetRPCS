<!--
    geetRPCS - Statistics window (ModernWpf / Fluent).
    Replaces the plain-text InfoDialog dumps produced by StatsCoordinator
    (ShowToday/ShowWeek/ShowMonth/ShowAllTime). Renders a rank list of the
    top apps, a per-view subtitle, total lines and an empty state. One
    shared modeless instance is reused across the four tray-menu views.
-->
<Window x:Class="geetRPCS.UI.Modern.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="Statistics"
        Width="440" Height="560"
        MinWidth="380" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        ui:ThemeManager.IsThemeAware="True"
        UseLayoutRounding="True"
        Background="{DynamicResource ApplicationPageBackgroundThemeBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="16,12,16,0">
            <TextBlock x:Name="TitleText" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="SubtitleText" Margin="0,4,0,0" FontSize="12"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,8,0,0">
            <!-- Virtualized like ManageAppsWindow: rows realize only as they scroll
                 into view, so the window opens instantly even with a long list.
                 ItemsControl must stay the direct ScrollViewer child for the
                 virtualization to engage. -->
            <ScrollViewer Padding="12,0,12,0" VerticalScrollBarVisibility="Auto"
                          CanContentScroll="True">
                <ItemsControl x:Name="RowsList"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Rank}" FontSize="13"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding AppName}" FontSize="13"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <!-- Overlay (hit-test transparent) so the empty state centers over the list. -->
            <TextBlock x:Name="EmptyText" Margin="16,24,16,16" FontSize="13"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       TextWrapping="Wrap" HorizontalAlignment="Center"
                       Visibility="Collapsed" IsHitTestVisible="False" />
        </Grid>

        <StackPanel Grid.Row="2" Margin="16,0,16,14">
            <Border Height="1"
                    Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <ItemsControl x:Name="TotalsList" Margin="0,10,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="12" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button x:Name="CloseButton" HorizontalAlignment="Right" Width="96" Height="32"
                    Margin="0,14,0,0" IsCancel="True" Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
