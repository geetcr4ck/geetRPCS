<!--
    geetRPCS - Manage Applications window (ModernWpf / Fluent).
    Replaces the WinForms ManageAppsForm with a Fluent-styled WPF window.
    Search filter, enable/disable per app, full per-app presence override
    editor (Details/State, large image, Application ID, elapsed time,
    buttons) and an Add Custom App flow — no JSON editing needed.
-->
<Window x:Class="geetRPCS.UI.Modern.ManageAppsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="Manage Applications"
        Width="450" Height="700"
        MinWidth="400" MinHeight="500"
        WindowStartupLocation="Manual"
        ui:ThemeManager.IsThemeAware="True"
        UseLayoutRounding="True"
        Background="{DynamicResource ApplicationPageBackgroundThemeBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="16,10,16,8">
            <TextBlock x:Name="TitleText" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <TextBox x:Name="SearchBox" Height="32" VerticalContentAlignment="Center"
                             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                             TextChanged="OnSearchTextChanged" />
                    <TextBlock x:Name="SearchPlaceholder" Margin="12,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               IsHitTestVisible="False" Focusable="False" />
                </Grid>
                <Button x:Name="AddAppButton" Grid.Column="1" Margin="8,0,0,0" Height="32" Padding="12,0"
                        Click="OnAddAppClick" />
            </Grid>
            <TextBlock x:Name="CountText" Margin="0,6,0,0" FontSize="12"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,0,12,16"
                      CanContentScroll="True">
            <!-- Virtualized: with ~100 apps the un-virtualized ItemsControl realized
                 every row's Expander + editor fields at once, hitching the UI for
                 several ms on open. CanContentScroll + Recycling makes rows realize
                 only as they scroll into view. -->
            <ItemsControl x:Name="AppsList"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="RowBorder" Margin="0,2" Padding="10,8" CornerRadius="6">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                            <Setter Property="Background"
                                                    Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            <Setter Property="Opacity" Value="0.6" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background"
                                                    Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                                        <!-- CUSTOM badge shown only on user-added apps -->
                                        <Border Visibility="{Binding IsCustomApp, Converter={StaticResource BoolToVisibility}}"
                                                Margin="8,0,0,0" Padding="6,1" CornerRadius="4"
                                                Background="{DynamicResource AccentFillColorDefaultBrush}">
                                            <TextBlock Text="{Binding CustomBadge}" FontSize="10"
                                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <Button Grid.Column="1" Margin="12,0,0,0" Padding="10,3" FontSize="12"
                                            Content="{Binding DeleteLabel}"
                                            Visibility="{Binding IsCustomApp, Converter={StaticResource BoolToVisibility}}"
                                            Click="OnDeleteCustomAppClick" />
                                    <CheckBox Grid.Column="2"
                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                              VerticalAlignment="Center" Margin="12,0,0,0" />
                                </Grid>
                                <Expander Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                          IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                    <Expander.Header>
                                        <TextBlock Text="{Binding CustomizeHeader}" FontSize="12" />
                                    </Expander.Header>
                                    <!-- Lazy editor: the ContentControl's template only
                                         materializes while the row is expanded (Editor =
                                         the row VM when expanded, null when collapsed).
                                         Collapsed rows — the vast majority — stay far
                                         lighter, so the debounced re-filter re-realizes
                                         fewer elements. -->
                                    <ContentControl Content="{Binding Editor}">
                                        <ContentControl.ContentTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,10,0,0">
                                                    <TextBlock Text="{Binding HintLabel}" FontSize="11"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                    <TextBlock Text="{Binding DetailsLabel}" Margin="0,8,0,0" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    <TextBox Margin="0,4,0,0" Height="30" VerticalContentAlignment="Center"
                                                             Text="{Binding Details, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Text="{Binding StateLabel}" Margin="0,10,0,0"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    <TextBox Margin="0,4,0,0" Height="30" VerticalContentAlignment="Center"
                                                             Text="{Binding State, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                                    <Grid Margin="0,10,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="12" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding LargeKeyLabel}" FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                            <TextBox Margin="0,4,0,0" Height="30" VerticalContentAlignment="Center"
                                                                     Text="{Binding LargeKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="{Binding LargeTextLabel}" FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                            <TextBox Margin="0,4,0,0" Height="30" VerticalContentAlignment="Center"
                                                                     Text="{Binding LargeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <TextBlock Text="{Binding ClientIdLabel}" Margin="0,10,0,0"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    <TextBox Margin="0,4,0,0" Height="30" VerticalContentAlignment="Center"
                                                             Text="{Binding ClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Text="{Binding ClientIdError}" FontSize="11" Margin="0,2,0,0"
                                                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                               Visibility="{Binding HasClientIdError, Converter={StaticResource BoolToVisibility}}" />

                                                    <CheckBox Margin="0,10,0,0" IsThreeState="True"
                                                              Content="{Binding TimestampsLabel}"
                                                              IsChecked="{Binding ShowTimestamps, Mode=TwoWay}" />

                                                    <TextBlock Text="{Binding ButtonsLabel}" Margin="0,10,0,0"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    <Grid Margin="0,4,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="12" />
                                                            <ColumnDefinition Width="1.6*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Height="30" MaxLength="32" VerticalContentAlignment="Center"
                                                                 Text="{Binding Button1Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        <TextBox Grid.Column="2" Height="30" VerticalContentAlignment="Center"
                                                                 Text="{Binding Button1Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    </Grid>
                                                    <Grid Margin="0,8,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="12" />
                                                            <ColumnDefinition Width="1.6*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Height="30" MaxLength="32" VerticalContentAlignment="Center"
                                                                 Text="{Binding Button2Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        <TextBox Grid.Column="2" Height="30" VerticalContentAlignment="Center"
                                                                 Text="{Binding Button2Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    </Grid>

                                                    <Button Margin="0,12,0,0" Padding="10,4" HorizontalAlignment="Left"
                                                            Content="{Binding ResetLabel}" Click="OnResetOverrideClick" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ContentControl.ContentTemplate>
                                    </ContentControl>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
