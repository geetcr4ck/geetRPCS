<!--
    geetRPCS - Message dialog (ModernWpf / Fluent).
    Replaces the last WinForms dialog surfaces: the custom InfoDialog /
    ConfirmDialog Forms and the native MessageBox calls. Three flavors:
    info (OK), error (OK + critical accent bar) and confirm (Yes/No with
    caution accent bar). Enter picks the affirmative button, Esc cancels.
-->
<Window x:Class="geetRPCS.UI.Modern.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="geetRPCS"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ui:ThemeManager.IsThemeAware="True"
        UseLayoutRounding="True"
        Background="{DynamicResource ApplicationPageBackgroundThemeBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Message with an optional severity accent bar (same pattern as the
             CustomRichPresenceWindow warning callout, minus the tinted background). -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="SeverityBar" Width="4" CornerRadius="2" Margin="0,2,12,2" Visibility="Collapsed" />
            <TextBlock x:Name="MessageText" Grid.Column="1" FontSize="13" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="NoButton" Width="96" Height="32" Margin="0,0,8,0" IsCancel="True" Click="OnNoClick" />
            <Button x:Name="YesButton" Width="96" Height="32"
                    Style="{StaticResource AccentButtonStyle}"
                    IsDefault="True" Click="OnYesClick" />
        </StackPanel>
    </Grid>
</Window>
