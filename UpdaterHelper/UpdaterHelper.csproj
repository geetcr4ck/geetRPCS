<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>Updater</AssemblyName>
    <RootNamespace>geetRPCS.Updater</RootNamespace>
    <ApplicationIcon>..\rpicon.ico</ApplicationIcon>
    <Version>1.4.1</Version>
    <AssemblyVersion>1.4.1.0</AssemblyVersion>
    <FileVersion>1.4.1.0</FileVersion>
    <Copyright>© 2026 geetcr4ck</Copyright>
    <Company>geetcr4ck</Company>
    <Product>geetRPCS Maintenance Tool</Product>
    <Description>Official maintenance utility for geetRPCS</Description>

    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>

    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>

    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared integrity-check implementation (must stay identical to geetRPCS) -->
    <Compile Include="..\Utils\DirectoryChecksum.cs" Link="Utils\DirectoryChecksum.cs" />
  </ItemGroup>
</Project>